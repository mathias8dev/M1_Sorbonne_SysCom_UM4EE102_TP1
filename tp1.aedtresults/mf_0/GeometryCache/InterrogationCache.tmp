$begin 'InterrogationCache'
	Version=1
	$begin 'ValidationStatus'
		$begin 'Options'
			EntityCheckLevel='Strict'
			IgnoreUnclassifiedObjects=false
			SkipIntersectionChecks=false
		$end 'Options'
		Status=true
	$end 'ValidationStatus'
	$begin 'BodyCaches'
		$begin '6'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -11.43, 0, 0]
				High[3: 11.43, 10.16, 100]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '6'
		$begin '34'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -12.43, -0.99999999999999944, 0]
				High[3: 12.43, 11.16, 100]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '34'
	$end 'BodyCaches'
	$begin 'IntersectionCaches'
	$end 'IntersectionCaches'
$end 'InterrogationCache'
